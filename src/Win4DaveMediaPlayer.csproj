<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Win4DaveMediaPlayer</AssemblyName>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <NativeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64'">aarch64</NativeArchitecture>
    <NativeArchitecture Condition="'$(NativeArchitecture)' == ''">x86_64</NativeArchitecture>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\native\$(NativeArchitecture)\libmpv-2.dll" Link="libmpv-2.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
